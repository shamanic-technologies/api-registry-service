{
  "openapi": "3.0.0",
  "info": {
    "title": "API Registry Service",
    "description": "Aggregates OpenAPI specs from multiple microservices into a single queryable registry. Provides REST endpoints and MCP tools for LLM-powered service discovery.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "service": {
            "type": "string",
            "enum": [
              "api-registry"
            ]
          },
          "registeredServices": {
            "type": "number"
          }
        },
        "required": [
          "status",
          "service",
          "registeredServices"
        ]
      },
      "ServicesResponse": {
        "type": "object",
        "properties": {
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServiceEntry"
            }
          }
        },
        "required": [
          "services"
        ]
      },
      "ServiceEntry": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "baseUrl": {
            "type": "string"
          },
          "openapiUrl": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "baseUrl",
          "openapiUrl"
        ]
      },
      "UnauthorizedError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "Invalid or missing API key"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "OpenApiSpec": {
        "type": "object",
        "properties": {},
        "additionalProperties": {
          "nullable": true
        },
        "description": "An OpenAPI specification object"
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "available": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "error"
        ]
      },
      "UpstreamError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "error",
          "detail"
        ]
      },
      "SearchResponse": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "resultCount": {
            "type": "number"
          },
          "indexSize": {
            "type": "number"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SearchResult"
            }
          }
        },
        "required": [
          "query",
          "resultCount",
          "indexSize",
          "results"
        ]
      },
      "SearchResult": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "score": {
            "type": "number"
          },
          "bodyFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "responseFields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "service",
          "method",
          "path",
          "summary",
          "score"
        ]
      },
      "LlmOverviewResponse": {
        "type": "object",
        "properties": {
          "_description": {
            "type": "string"
          },
          "_workflow": {
            "type": "string"
          },
          "serviceCount": {
            "type": "number"
          },
          "services": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LlmOverviewService"
            }
          }
        },
        "required": [
          "_description",
          "_workflow",
          "serviceCount",
          "services"
        ]
      },
      "LlmOverviewService": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "error": {
            "type": "string"
          },
          "endpointCount": {
            "type": "number"
          }
        },
        "required": [
          "service",
          "endpointCount"
        ]
      },
      "LlmServiceDetailResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "endpointCount": {
            "type": "number"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LlmServiceEndpoint"
            }
          },
          "totalEndpoints": {
            "type": "number"
          },
          "groupCount": {
            "type": "number"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LlmEndpointGroup"
            }
          }
        },
        "required": [
          "service"
        ]
      },
      "LlmServiceEndpoint": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "method",
          "path",
          "summary"
        ]
      },
      "LlmEndpointGroup": {
        "type": "object",
        "properties": {
          "group": {
            "type": "string"
          },
          "endpointCount": {
            "type": "number"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LlmServiceEndpoint"
            }
          }
        },
        "required": [
          "group",
          "endpointCount",
          "endpoints"
        ]
      },
      "CallApiResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "number",
            "description": "HTTP status code from downstream service"
          },
          "ok": {
            "type": "boolean",
            "description": "Whether the response status was 2xx"
          },
          "data": {
            "nullable": true,
            "description": "Response body from downstream service"
          }
        },
        "required": [
          "status",
          "ok"
        ]
      },
      "MissingHeadersError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "Missing required headers: x-org-id, x-user-id"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "ProxyError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CallApiRequest": {
        "type": "object",
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "path": {
            "type": "string",
            "description": "Endpoint path on the target service (e.g. '/v1/campaigns')"
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Additional headers to forward"
          },
          "body": {
            "type": "object",
            "additionalProperties": {
              "nullable": true
            },
            "description": "Request body for POST/PUT/PATCH"
          }
        },
        "required": [
          "method",
          "path"
        ]
      },
      "DiscoverServicesResponse": {
        "type": "object",
        "properties": {
          "serviceCount": {
            "type": "number"
          },
          "matched": {
            "type": "number"
          },
          "services": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "description": "One line"
                },
                "endpoints": {
                  "type": "number",
                  "nullable": true,
                  "description": "Endpoint count (health/openapi excluded); null when the spec is unreachable"
                },
                "error": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "description",
                "endpoints"
              ]
            }
          },
          "_next": {
            "type": "string"
          }
        },
        "required": [
          "serviceCount",
          "matched",
          "services",
          "_next"
        ]
      },
      "DiscoverEndpointsResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "endpointCount": {
            "type": "number"
          },
          "matched": {
            "type": "number"
          },
          "shown": {
            "type": "number"
          },
          "_more": {
            "type": "string"
          },
          "statsBasis": {
            "type": "string",
            "description": "How the stats are computed"
          },
          "statsAsOf": {
            "type": "string"
          },
          "statsError": {
            "type": "string",
            "description": "Present when runs-service stats could not be read; endpoints then carry stats 'unavailable'"
          },
          "roi": {
            "type": "string",
            "description": "ROI status: not served until features-service serves a value per step"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "summary": {
                  "type": "string",
                  "description": "One line"
                },
                "stats": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/RunStats"
                    },
                    {
                      "type": "string"
                    }
                  ],
                  "description": "Run stats, or a sentence saying why there are none: 'no runs yet', or 'not measured: no run task linked to this endpoint yet'"
                }
              },
              "required": [
                "method",
                "path",
                "summary",
                "stats"
              ]
            }
          },
          "unlinkedTasks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "task": {
                  "type": "string"
                },
                "runs": {
                  "type": "number"
                },
                "successRate": {
                  "type": "number",
                  "nullable": true
                },
                "avgCostUsd": {
                  "type": "number"
                },
                "avgDurationMs": {
                  "type": "number",
                  "nullable": true
                }
              },
              "required": [
                "task",
                "runs",
                "successRate",
                "avgCostUsd",
                "avgDurationMs"
              ]
            },
            "description": "Run tasks of this service that no endpoint claims (crons, internal jobs), top 5 by runs"
          },
          "unlinkedTaskCount": {
            "type": "number"
          },
          "_next": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "description",
          "endpointCount",
          "matched",
          "shown",
          "statsBasis",
          "roi",
          "endpoints",
          "_next"
        ]
      },
      "RunStats": {
        "type": "object",
        "properties": {
          "successRate": {
            "type": "number",
            "nullable": true,
            "description": "completed / (completed + failed) over the sampled runs; null when none ended"
          },
          "avgCostUsd": {
            "type": "number",
            "description": "Mean whole-run cost in USD: the run's own and every sub-call's actual costs, at catalogue price"
          },
          "avgDurationMs": {
            "type": "number",
            "nullable": true,
            "description": "Mean duration of the sampled COMPLETED runs; null when none completed"
          },
          "runs": {
            "type": "number",
            "description": "All-time run count of the task(s) behind this endpoint, all orgs"
          },
          "sampled": {
            "type": "number",
            "description": "Runs measured: the most recent ones, at most 200 per task"
          },
          "lastRunAt": {
            "type": "string",
            "nullable": true
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Run task names merged into this endpoint, when more than one"
          }
        },
        "required": [
          "successRate",
          "avgCostUsd",
          "avgDurationMs",
          "runs",
          "sampled",
          "lastRunAt"
        ]
      },
      "DiscoverEndpointResponse": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "method": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "parameters": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {},
              "additionalProperties": {
                "nullable": true
              }
            }
          },
          "requestBody": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "nullable": true
            }
          },
          "responses": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "nullable": true
            }
          },
          "stats": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RunStats"
              },
              {
                "type": "string"
              }
            ],
            "description": "Run stats, or a sentence saying why there are none: 'no runs yet', or 'not measured: no run task linked to this endpoint yet'"
          },
          "statsBasis": {
            "type": "string"
          },
          "roi": {
            "type": "string"
          },
          "testRun": {
            "type": "object",
            "properties": {
              "mcp": {
                "type": "string"
              },
              "http": {
                "type": "string"
              },
              "billing": {
                "type": "string"
              }
            },
            "required": [
              "mcp",
              "http",
              "billing"
            ]
          }
        },
        "required": [
          "service",
          "method",
          "path",
          "stats",
          "roi",
          "testRun"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/services": {
      "get": {
        "summary": "List all registered services",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Internal org UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal org UUID from client-service (optional for read-only endpoints)",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal user UUID from client-service (optional for read-only endpoints)",
            "name": "x-user-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "List of registered services",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServicesResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          }
        }
      }
    },
    "/openapi/{service}": {
      "get": {
        "summary": "Get OpenAPI spec for a specific service",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Service name"
            },
            "required": true,
            "description": "Service name",
            "name": "service",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal org UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal org UUID from client-service (optional for read-only endpoints)",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal user UUID from client-service (optional for read-only endpoints)",
            "name": "x-user-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "OpenAPI spec for the service",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiSpec"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          },
          "404": {
            "description": "Service not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Failed to fetch spec from upstream",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UpstreamError"
                }
              }
            }
          }
        }
      }
    },
    "/search": {
      "get": {
        "summary": "Search for API endpoints across all services using ranked full-text search. Supports fuzzy matching and prefix search.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Search query (e.g. 'send email', 'brand extract')"
            },
            "required": true,
            "description": "Search query (e.g. 'send email', 'brand extract')",
            "name": "q",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter to a specific service"
            },
            "required": false,
            "description": "Filter to a specific service",
            "name": "service",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by HTTP method (e.g. 'POST')"
            },
            "required": false,
            "description": "Filter by HTTP method (e.g. 'POST')",
            "name": "method",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by path prefix (e.g. '/v1/')"
            },
            "required": false,
            "description": "Filter by path prefix (e.g. '/v1/')",
            "name": "pathPrefix",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Max results (omit for all results)"
            },
            "required": false,
            "description": "Max results (omit for all results)",
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal org UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal org UUID from client-service (optional for read-only endpoints)",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal user UUID from client-service (optional for read-only endpoints)",
            "name": "x-user-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Ranked search results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            }
          },
          "400": {
            "description": "Missing query parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          }
        }
      }
    },
    "/llm-context": {
      "get": {
        "summary": "LLM-friendly overview: list all services with name, description, and endpoint count. Use GET /llm-context/{service} for endpoint details.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Internal org UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal org UUID from client-service (optional for read-only endpoints)",
            "name": "x-org-id",
            "in": "header"
          },
          {
            "schema": {
              "type": "string",
              "description": "Internal user UUID from client-service (optional for read-only endpoints)"
            },
            "required": false,
            "description": "Internal user UUID from client-service (optional for read-only endpoints)",
            "name": "x-user-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Lightweight service overview for LLM consumption",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LlmOverviewResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedError"
                }
              }
            }
          }
        }
      }
    },
    "/llm-context/{service}": {
      "get": {
        "summary": "LLM-friendly endpoint list for a specific service. Supports filtering by method, path group, or path prefix. Large services (30+ endpoints) auto-group by path prefix.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Service name"
            },
            "required": true,
            "description": "Service name",
            "name": "service",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by HTTP method (e.g. 'POST')"
            },
            "required": false,
            "description": "Filter by HTTP method (e.g. 'POST')",
            "name": "method",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by path group (e.g. 'campaigns', 'brands')"
            },
            "required": false,
            "description": "Filter by path group (e.g. 'campaigns', 'brands')",
            "name": "group",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Filter by path prefix (e.g. '/v1/campaigns')"
            },
            "required": false,
            "description": "Filter by path prefix (e.g. '/v1/campaigns')",
            "name": "pathPrefix",
            "in": "query"
          },
          {
